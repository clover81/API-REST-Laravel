    "name": "Middle Earth API – Runner OK v2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Versión v2: compatible con Postman sin pm.utils.get. Guarda IDs desde response.json().id."
  },
  "item": [
    {
      "name": "0) Setup",
      "item": [
        {
          "name": "GET /regions (sets runSuffix)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/regions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "regions"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get(\"runSuffix\")) {",
                  "  pm.environment.set(\"runSuffix\", Date.now().toString());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
